diff --git a/Sources/XFrame/AcceptanceRecorder.swift b/Sources/XFrame/AcceptanceRecorder.swift
new file mode 100644
index 0000000..d6706b3
--- /dev/null
+++ b/Sources/XFrame/AcceptanceRecorder.swift
@@ -0,0 +1,67 @@
+import Foundation
+import QuartzCore
+import Darwin
+
+// ACCEPTANCE DIAGNOSTICS ONLY (not part of the integration candidate). Active only when the environment variable
+// XFRAME_ACCEPT_DIR is set. Main thread only. Records, per LiveVideo session: process CPU (1 s), a few stream counters
+// (5 s), render-worker ownership transitions and stop durations, worker policy readback; on session end writes
+// <dir>/session-<n>.json with the production diagnosticReport (including the frame trace) on the main thread after
+// playback has stopped (never during measurement).
+@MainActor final class AcceptanceRecorder {
+    static let shared = AcceptanceRecorder()
+    static let directory = ProcessInfo.processInfo.environment["XFRAME_ACCEPT_DIR"]
+    static var enabled: Bool { directory != nil }
+    static var traceCapacity: Int? { ProcessInfo.processInfo.environment["XFRAME_ACCEPT_TRACE_CAPACITY"].flatMap(Int.init) }
+
+    private struct Sample: Encodable { let t: Double; let cpu: Double; let decoded: Int?; let presented: Int?; let dropped: Int?
+        let videoPackets: Int?; let videoLost: Int?; let nacks: Int?; let audioPackets: Int?; let audioEnergy: Double? }
+    private struct Event: Encodable { let t: Double; let name: String; let value: Double? }
+    private struct Session: Encodable {
+        let workerEnabled: Bool; let started: Double; let ended: Double; let traceOrigin: Double
+        let samples: [Sample]; let events: [Event]; let report: StreamDiagnosticReport
+    }
+    private var source: LiveVideo?, workerEnabled = false, started = 0.0, samples: [Sample] = [], events: [Event] = []
+    private var timer: Timer?, tick = 0, index = 0
+
+    private static func cpuSeconds() -> Double {
+        var ru = rusage(); getrusage(RUSAGE_SELF, &ru)
+        return Double(ru.ru_utime.tv_sec) + Double(ru.ru_utime.tv_usec) / 1e6 + Double(ru.ru_stime.tv_sec) + Double(ru.ru_stime.tv_usec) / 1e6
+    }
+    func event(_ name: String, _ value: Double? = nil) {
+        guard Self.enabled, source != nil else { return }
+        events.append(Event(t: CACurrentMediaTime(), name: name, value: value))
+    }
+    func begin(_ live: LiveVideo, workerEnabled: Bool) {
+        guard Self.enabled else { return }
+        source = live; self.workerEnabled = workerEnabled; started = CACurrentMediaTime(); samples = []; events = []; tick = 0
+        let t = Timer(timeInterval: 1.0, repeats: true) { _ in MainActor.assumeIsolated { AcceptanceRecorder.shared.sample() } }
+        RunLoop.main.add(t, forMode: .common); timer = t
+        event(workerEnabled ? "mode.worker" : "mode.mtk")
+    }
+    private func sample() {
+        guard let source else { return }
+        let now = CACurrentMediaTime(); tick += 1
+        if tick % 5 == 0 {
+            let s = source.snapshot()
+            samples.append(Sample(t: now, cpu: Self.cpuSeconds(), decoded: s.decoded, presented: s.presented, dropped: s.dropped,
+                                  videoPackets: s.videoPacketsReceived, videoLost: s.videoPacketsLost, nacks: s.videoNacks,
+                                  audioPackets: s.audioPacketsReceived, audioEnergy: s.audioEnergy))
+        } else {
+            samples.append(Sample(t: now, cpu: Self.cpuSeconds(), decoded: nil, presented: nil, dropped: nil, videoPackets: nil,
+                                  videoLost: nil, nacks: nil, audioPackets: nil, audioEnergy: nil))
+        }
+    }
+    /// Called when the renderer leaves this source (new source or nil). Writes the session file.
+    func end() {
+        guard Self.enabled, let source, let dir = Self.directory else { return }
+        timer?.invalidate(); timer = nil
+        let session = Session(workerEnabled: workerEnabled, started: started, ended: CACurrentMediaTime(),
+                              traceOrigin: source.frameTrace.origin, samples: samples, events: events, report: source.diagnosticReport())
+        self.source = nil
+        index += 1
+        let url = URL(fileURLWithPath: dir).appendingPathComponent(String(format: "session-%02d-%d.json", index, Int(Date().timeIntervalSince1970)))
+        try? FileManager.default.createDirectory(atPath: dir, withIntermediateDirectories: true)
+        let encoder = JSONEncoder()
+        if let data = try? encoder.encode(session) { try? data.write(to: url) }
+    }
+}
